# SAMRAKSHA — Environment Configuration
# Copy this file to .env and fill in your values.

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql+asyncpg://samraksha:samraksha_secret@postgres:5432/samraksha"

# REDIS_URL: Redis connection string
REDIS_URL="redis://redis:6379/0"

# SECRET_KEY: JWT signing secret — use a strong random string (min 32 chars)
SECRET_KEY="samraksha-super-secret-jwt-key-change-in-prod"

# ENVIRONMENT: 'development' or 'production'
ENVIRONMENT="development"

# ACCESS_TOKEN_EXPIRE_MINUTES: Duration of access token validity
ACCESS_TOKEN_EXPIRE_MINUTES="480"

# CORS_ORIGINS: Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# VITE_API_URL: Backend API base URL (used by Vite dev server proxy)
VITE_API_URL="http://localhost:8000"

# GEMINI_API_KEY: Optional — for Gemini AI API integration
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"
